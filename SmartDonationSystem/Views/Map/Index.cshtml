@{
    ViewData["Title"] = "Interactive Map";
    if (User.IsInRole("Admin"))
    {
        Layout = "_AdminLayout";
    }
    else if (User.IsInRole("NGO"))
    {
        Layout = "_NGOLayout";
    }
    else if (User.IsInRole("Donor"))
    {
        Layout = "_DonorLayout";
    }
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fas fa-map-marked-alt me-2 text-primary"></i>Interactive Map
        </h2>
        <p class="text-muted mb-0">Locate donations and NGOs on an interactive map</p>
    </div>
</div>

<!-- Map Legend Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="fas fa-map-marker-alt fa-2x text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-semibold mb-1">Your Location</h6>
                        <small class="text-muted">Current position</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="fas fa-gift fa-2x text-success"></i>
                    </div>
                    <div>
                        <h6 class="fw-semibold mb-1">Donations</h6>
                        <small class="text-muted">Available food donations</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="fas fa-building fa-2x text-info"></i>
                    </div>
                    <div>
                        <h6 class="fw-semibold mb-1">NGOs</h6>
                        <small class="text-muted">Non-profit organizations</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Map Container -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm map-card-dark">
            <div class="card-header border-bottom py-3 map-card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">
                        <i class="fas fa-map me-2 text-primary"></i>Map View
                    </h5>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" id="mapTypeRoadmap" title="Roadmap">
                            <i class="fas fa-map"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="mapTypeSatellite" title="Satellite">
                            <i class="fas fa-satellite"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="mapTypeTerrain" title="Terrain">
                            <i class="fas fa-mountain"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <!-- Map Container -->
                <div id="map" class="map-container-dark" style="height: 600px; width: 100%; min-height: 400px;">
                    <!-- Google Maps will be initialized here -->
                    <div class="d-flex align-items-center justify-content-center h-100 map-loading-placeholder">
                        <div class="text-center">
                            <i class="fas fa-map-marked-alt fa-4x text-muted mb-3"></i>
                            <h6 class="fw-semibold mb-2">Map Loading...</h6>
                            <p class="text-muted small mb-0">
                                Google Maps will be initialized here
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Controls & Nearby Donations Sidebar -->
    <div class="col-lg-4">
        <!-- Search Controls -->
        <div class="card border-0 shadow-sm mb-4 map-card-dark">
            <div class="card-header border-bottom py-3 map-card-header">
                <h5 class="mb-0 fw-semibold">
                    <i class="fas fa-search me-2 text-primary"></i>Search & Controls
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="addressInput" class="form-label fw-semibold">
                        <i class="fas fa-map-marker-alt me-1 text-muted"></i>Search Address
                    </label>
                    <div class="input-group">
                        <input type="text" id="addressInput" class="form-control" placeholder="Enter address...">
                        <button id="searchBtn" class="btn btn-primary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="radiusSelect" class="form-label fw-semibold">
                        <i class="fas fa-circle-notch me-1 text-muted"></i>Search Radius
                    </label>
                    <select id="radiusSelect" class="form-select">
                        <option value="5">5 km</option>
                        <option value="10">10 km</option>
                        <option value="25" selected>25 km</option>
                        <option value="50">50 km</option>
                        <option value="100">100 km</option>
                    </select>
                </div>
                
                <div class="d-grid gap-2">
                    <button id="findNearbyNGOs" class="btn btn-info">
                        <i class="fas fa-building me-2"></i>Find Nearby NGOs
                    </button>
                    <button id="showDonations" class="btn btn-success">
                        <i class="fas fa-gift me-2"></i>Show Donations
                    </button>
                    <button id="clearMap" class="btn btn-outline-secondary">
                        <i class="fas fa-eraser me-2"></i>Clear Map
                    </button>
                </div>
            </div>
        </div>

        <!-- Nearby Donations List -->
        <div class="card border-0 shadow-sm map-card-dark">
            <div class="card-header border-bottom py-3 map-card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">
                        <i class="fas fa-gift me-2 text-success"></i>Nearby Donations
                    </h5>
                    <span class="badge bg-success" id="donationCount">0</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="donationList" style="max-height: 500px; overflow-y: auto;">
                    <!-- Placeholder for donation markers -->
                    <div class="p-4 text-center text-muted">
                        <i class="fas fa-map-marker-alt fa-3x mb-3 opacity-50"></i>
                        <h6 class="fw-semibold mb-2">Donation Markers</h6>
                        <p class="small mb-0">
                            Click "Show Donations" to display nearby food donations on the map
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Map Features Info -->
<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="fas fa-info-circle me-2 text-primary"></i>Map Features
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-search text-primary"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Search Locations</h6>
                                <p class="small text-muted mb-0">Find addresses and locations quickly</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-gift text-success"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Donation Markers</h6>
                                <p class="small text-muted mb-0">View all available food donations</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-building text-info"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">NGO Locations</h6>
                                <p class="small text-muted mb-0">Find nearby organizations</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-warning bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-route text-warning"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Route Planning</h6>
                                <p class="small text-muted mb-0">Plan efficient pickup routes</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Map variables
        let map;
        let donationMarkers = [];
        let ngoMarkers = [];
        let userMarker = null;
        let geocoder;
        let autocomplete;
        const defaultCenter = { lat: 40.7128, lng: -74.0060 }; // Default to New York
        const defaultZoom = 12;

        // Initialize map function - called by Google Maps API callback
        function initMap() {
            try {
                const mapContainer = document.getElementById('map');
                if (!mapContainer) {
                    console.error('Map container not found');
                    return;
                }

                // Check if Google Maps API is loaded
                if (typeof google === 'undefined' || !google.maps) {
                    showMapError('Google Maps API failed to load');
                    return;
                }

                // Get current theme
                const isDarkMode = document.documentElement.getAttribute('data-theme') === 'dark';
                
                // Dark theme styles for Google Maps
                const darkMapStyles = [
                    { elementType: 'geometry', stylers: [{ color: '#242f3e' }] },
                    { elementType: 'labels.text.stroke', stylers: [{ color: '#242f3e' }] },
                    { elementType: 'labels.text.fill', stylers: [{ color: '#746855' }] },
                    {
                        featureType: 'administrative.locality',
                        elementType: 'labels.text.fill',
                        stylers: [{ color: '#d59563' }]
                    },
                    {
                        featureType: 'poi',
                        elementType: 'labels.text.fill',
                        stylers: [{ color: '#d59563' }]
                    },
                    {
                        featureType: 'poi.park',
                        elementType: 'geometry',
                        stylers: [{ color: '#263c3f' }]
                    },
                    {
                        featureType: 'poi.park',
                        elementType: 'labels.text.fill',
                        stylers: [{ color: '#6b9a76' }]
                    },
                    {
                        featureType: 'road',
                        elementType: 'geometry',
                        stylers: [{ color: '#38414e' }]
                    },
                    {
                        featureType: 'road',
                        elementType: 'geometry.stroke',
                        stylers: [{ color: '#212a37' }]
                    },
                    {
                        featureType: 'road',
                        elementType: 'labels.text.fill',
                        stylers: [{ color: '#9ca5b3' }]
                    },
                    {
                        featureType: 'road.highway',
                        elementType: 'geometry',
                        stylers: [{ color: '#746855' }]
                    },
                    {
                        featureType: 'road.highway',
                        elementType: 'geometry.stroke',
                        stylers: [{ color: '#1f2835' }]
                    },
                    {
                        featureType: 'road.highway',
                        elementType: 'labels.text.fill',
                        stylers: [{ color: '#f3d19c' }]
                    },
                    {
                        featureType: 'transit',
                        elementType: 'geometry',
                        stylers: [{ color: '#2f3948' }]
                    },
                    {
                        featureType: 'transit.station',
                        elementType: 'labels.text.fill',
                        stylers: [{ color: '#d59563' }]
                    },
                    {
                        featureType: 'water',
                        elementType: 'geometry',
                        stylers: [{ color: '#17263c' }]
                    },
                    {
                        featureType: 'water',
                        elementType: 'labels.text.fill',
                        stylers: [{ color: '#515c6d' }]
                    },
                    {
                        featureType: 'water',
                        elementType: 'labels.text.stroke',
                        stylers: [{ color: '#17263c' }]
                    }
                ];
                
                // Initialize map with theme
                map = new google.maps.Map(mapContainer, {
                    center: defaultCenter,
                    zoom: defaultZoom,
                    mapTypeId: google.maps.MapTypeId.ROADMAP,
                    streetViewControl: false,
                    fullscreenControl: true,
                    styles: isDarkMode ? darkMapStyles : []
                });
                
                // Function to update map theme
                window.updateMapTheme = function(isDark) {
                    if (map) {
                        map.setOptions({
                            styles: isDark ? darkMapStyles : []
                        });
                    }
                };
                
                // Listen for theme changes
                window.addEventListener('themeChange', function(e) {
                    const newIsDark = e.detail.theme === 'dark';
                    if (window.updateMapTheme) {
                        window.updateMapTheme(newIsDark);
                    }
                });

                // Initialize geocoder
                geocoder = new google.maps.Geocoder();

                // Initialize autocomplete for address input
                const addressInput = document.getElementById('addressInput');
                if (addressInput) {
                    autocomplete = new google.maps.places.Autocomplete(addressInput, {
                        types: ['address'],
                        componentRestrictions: { country: 'us' }
                    });
                    autocomplete.addListener('place_changed', function() {
                        const place = autocomplete.getPlace();
                        if (place.geometry) {
                            map.setCenter(place.geometry.location);
                            map.setZoom(15);
                            if (userMarker) {
                                userMarker.setPosition(place.geometry.location);
                            } else {
                                userMarker = new google.maps.Marker({
                                    position: place.geometry.location,
                                    map: map,
                                    title: 'Your Location',
                                    icon: {
                                        url: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png'
                                    }
                                });
                            }
                        }
                    });
                }

                // Try to get user's current location
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(
                        function(position) {
                            const userLocation = {
                                lat: position.coords.latitude,
                                lng: position.coords.longitude
                            };
                            map.setCenter(userLocation);
                            map.setZoom(15);
                            userMarker = new google.maps.Marker({
                                position: userLocation,
                                map: map,
                                title: 'Your Location',
                                icon: {
                                    url: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png'
                                }
                            });
                        },
                        function(error) {
                            console.warn('Geolocation error:', error.message);
                            // Continue with default location
                        }
                    );
                }

                console.log('Map initialized successfully');
            } catch (error) {
                console.error('Error initializing map:', error);
                showMapError('Failed to initialize map: ' + error.message);
            }
        }

        // Show error message in map container
        function showMapError(message) {
            const mapContainer = document.getElementById('map');
            if (mapContainer) {
                mapContainer.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 bg-light"><div class="text-center"><i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i><h6 class="fw-semibold mb-2">Map Error</h6><p class="text-muted small mb-0">' + message + '</p></div></div>';
            }
        }

        // Search address function
        document.getElementById('searchBtn')?.addEventListener('click', function() {
            const address = document.getElementById('addressInput')?.value;
            if (!address) {
                alert('Please enter an address');
                return;
            }

            if (!geocoder) {
                alert('Geocoder not initialized');
                return;
            }

            geocoder.geocode({ address: address }, function(results, status) {
                if (status === 'OK' && results[0]) {
                    map.setCenter(results[0].geometry.location);
                    map.setZoom(15);
                    if (userMarker) {
                        userMarker.setPosition(results[0].geometry.location);
                    } else {
                        userMarker = new google.maps.Marker({
                            position: results[0].geometry.location,
                            map: map,
                            title: address
                        });
                    }
                } else {
                    alert('Address not found: ' + status);
                }
            });
        });

        // Show donations on map
        document.getElementById('showDonations')?.addEventListener('click', async function() {
            if (!map) {
                alert('Map not initialized');
                return;
            }

            try {
                const response = await fetch('/Map/DonationMap');
                if (!response.ok) {
                    throw new Error('Failed to load donations');
                }
                const markers = await response.json();
                
                // Clear existing donation markers
                donationMarkers.forEach(marker => marker.setMap(null));
                donationMarkers = [];

                // Add new markers
                markers.forEach(markerData => {
                    if (markerData.Latitude && markerData.Longitude) {
                        const marker = new google.maps.Marker({
                            position: { lat: markerData.Latitude, lng: markerData.Longitude },
                            map: map,
                            title: markerData.Title,
                            icon: {
                                url: 'http://maps.google.com/mapfiles/ms/icons/green-dot.png'
                            }
                        });

                        const infoWindow = new google.maps.InfoWindow({
                            content: '<div><h6>' + markerData.Title + '</h6><p>' + markerData.Description + '</p></div>'
                        });

                        marker.addListener('click', function() {
                            infoWindow.open(map, marker);
                        });

                        donationMarkers.push(marker);
                    }
                });

                document.getElementById('donationCount').textContent = donationMarkers.length.toString();
            } catch (error) {
                console.error('Error loading donations:', error);
                alert('Failed to load donations: ' + error.message);
            }
        });

        // Find nearby NGOs
        document.getElementById('findNearbyNGOs')?.addEventListener('click', async function() {
            if (!map || !userMarker) {
                alert('Please set your location first');
                return;
            }

            const position = userMarker.getPosition();
            const radius = document.getElementById('radiusSelect')?.value || 25;

            try {
                const response = await fetch(`/Map/NearbyNGOs?latitude=${position.lat()}&longitude=${position.lng()}&radiusKm=${radius}`);
                if (!response.ok) {
                    throw new Error('Failed to load nearby NGOs');
                }
                const ngos = await response.json();
                
                // Clear existing NGO markers
                ngoMarkers.forEach(marker => marker.setMap(null));
                ngoMarkers = [];

                // Add new markers
                ngos.forEach(ngo => {
                    if (ngo.Location && ngo.Location.Latitude && ngo.Location.Longitude) {
                        const marker = new google.maps.Marker({
                            position: { lat: ngo.Location.Latitude, lng: ngo.Location.Longitude },
                            map: map,
                            title: ngo.Name,
                            icon: {
                                url: 'http://maps.google.com/mapfiles/ms/icons/blue-dot.png'
                            }
                        });

                        const infoWindow = new google.maps.InfoWindow({
                            content: '<div><h6>' + ngo.Name + '</h6><p>' + ngo.Description + '</p><p>Distance: ' + ngo.DistanceKm + ' km</p></div>'
                        });

                        marker.addListener('click', function() {
                            infoWindow.open(map, marker);
                        });

                        ngoMarkers.push(marker);
                    }
                });
            } catch (error) {
                console.error('Error loading nearby NGOs:', error);
                alert('Failed to load nearby NGOs: ' + error.message);
            }
        });

        // Clear map
        document.getElementById('clearMap')?.addEventListener('click', function() {
            donationMarkers.forEach(marker => marker.setMap(null));
            ngoMarkers.forEach(marker => marker.setMap(null));
            donationMarkers = [];
            ngoMarkers = [];
            document.getElementById('donationCount').textContent = '0';
        });

        // Map type switching
        document.getElementById('mapTypeRoadmap')?.addEventListener('click', function() {
            if (map) {
                map.setMapTypeId(google.maps.MapTypeId.ROADMAP);
            }
        });

        document.getElementById('mapTypeSatellite')?.addEventListener('click', function() {
            if (map) {
                map.setMapTypeId(google.maps.MapTypeId.SATELLITE);
            }
        });

        document.getElementById('mapTypeTerrain')?.addEventListener('click', function() {
            if (map) {
                map.setMapTypeId(google.maps.MapTypeId.TERRAIN);
            }
        });

        // Fallback if Google Maps API doesn't load
        window.addEventListener('load', function() {
            setTimeout(function() {
                if (typeof google === 'undefined' || !google.maps) {
                    console.warn('Google Maps API not loaded after timeout');
                    if (typeof initMap === 'function') {
                        initMap(); // Will show error message
                    }
                }
            }, 5000);
        });
    </script>
    
    <!-- Google Maps API Script - Load at end of page -->
    @if (!string.IsNullOrEmpty(ViewBag.GoogleMapsApiKey) && ViewBag.GoogleMapsApiKey != "YOUR_GOOGLE_MAPS_API_KEY_HERE")
    {
        <script async defer 
                src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&libraries=places,geometry&callback=initMap"
                onerror="console.error('Failed to load Google Maps API'); if(typeof initMap === 'function') initMap();">
        </script>
    }
    else
    {
        <script>
            console.warn('Google Maps API key is not configured');
            // Initialize error display
            function initMap() {
                const mapContainer = document.getElementById('map');
                if (mapContainer) {
                    mapContainer.innerHTML = '<div class="d-flex align-items-center justify-content-center h-100 bg-light"><div class="text-center"><i class="fas fa-exclamation-triangle fa-3x text-warning mb-3"></i><h6 class="fw-semibold mb-2">Google Maps API Key Required</h6><p class="text-muted small mb-0">Please configure the Google Maps API key in appsettings.json under GoogleMaps:ApiKey</p></div></div>';
                }
            }
            // Call immediately for error display
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initMap);
            } else {
                initMap();
            }
        </script>
    }
}

@section Styles {
    <style>
        #map {
            border-radius: 0 0 0.5rem 0.5rem;
        }

        .map-card-dark {
            background-color: var(--card-bg);
            border-color: var(--card-border);
            transition: background-color 0.3s ease, border-color 0.3s ease;
        }

        .map-card-header {
            background-color: var(--card-bg) !important;
            border-bottom-color: var(--border-light) !important;
            color: var(--text-primary);
            transition: background-color 0.3s ease, border-color 0.3s ease, color 0.3s ease;
        }

        .map-container-dark {
            background-color: var(--bg-secondary);
            transition: background-color 0.3s ease;
        }

        .map-loading-placeholder {
            background-color: var(--bg-secondary);
            color: var(--text-secondary);
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        #donationList {
            scrollbar-width: thin;
            scrollbar-color: var(--border-color) transparent;
        }

        #donationList::-webkit-scrollbar {
            width: 6px;
        }

        #donationList::-webkit-scrollbar-track {
            background: transparent;
        }

        #donationList::-webkit-scrollbar-thumb {
            background-color: var(--border-color);
            border-radius: 3px;
        }

        #donationList::-webkit-scrollbar-thumb:hover {
            background-color: var(--text-muted);
        }

        @@media (max-width: 992px) {
            #map {
                height: 400px !important;
            }
        }

        @@media (max-width: 768px) {
            #map {
                height: 350px !important;
            }
        }
    </style>
}
