@{
    ViewData["Title"] = "Interactive Map";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="fas fa-map-marked-alt me-2 text-primary"></i>Interactive Map
        </h2>
        <p class="text-muted mb-0">Locate donations and NGOs on an interactive map</p>
    </div>
</div>

<!-- Map Legend Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="fas fa-map-marker-alt fa-2x text-primary"></i>
                    </div>
                    <div>
                        <h6 class="fw-semibold mb-1">Your Location</h6>
                        <small class="text-muted">Current position</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="fas fa-gift fa-2x text-success"></i>
                    </div>
                    <div>
                        <h6 class="fw-semibold mb-1">Donations</h6>
                        <small class="text-muted">Available food donations</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 rounded-circle p-3 me-3">
                        <i class="fas fa-building fa-2x text-info"></i>
                    </div>
                    <div>
                        <h6 class="fw-semibold mb-1">NGOs</h6>
                        <small class="text-muted">Non-profit organizations</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Map Container -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">
                        <i class="fas fa-map me-2 text-primary"></i>Map View
                    </h5>
                    <div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-primary" id="mapTypeRoadmap" title="Roadmap">
                            <i class="fas fa-map"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="mapTypeSatellite" title="Satellite">
                            <i class="fas fa-satellite"></i>
                        </button>
                        <button type="button" class="btn btn-outline-primary" id="mapTypeTerrain" title="Terrain">
                            <i class="fas fa-mountain"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body p-0">
                <!-- Map Container -->
                <div id="map" style="height: 600px; width: 100%; min-height: 400px;">
                    <!-- Google Maps will be initialized here -->
                    <div class="d-flex align-items-center justify-content-center h-100 bg-light">
                        <div class="text-center">
                            <i class="fas fa-map-marked-alt fa-4x text-muted mb-3"></i>
                            <h6 class="fw-semibold mb-2">Map Loading...</h6>
                            <p class="text-muted small mb-0">
                                Google Maps will be initialized here
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Controls & Nearby Donations Sidebar -->
    <div class="col-lg-4">
        <!-- Search Controls -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="fas fa-search me-2 text-primary"></i>Search & Controls
                </h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="addressInput" class="form-label fw-semibold">
                        <i class="fas fa-map-marker-alt me-1 text-muted"></i>Search Address
                    </label>
                    <div class="input-group">
                        <input type="text" id="addressInput" class="form-control" placeholder="Enter address...">
                        <button id="searchBtn" class="btn btn-primary" type="button">
                            <i class="fas fa-search"></i>
                        </button>
                    </div>
                </div>
                
                <div class="mb-3">
                    <label for="radiusSelect" class="form-label fw-semibold">
                        <i class="fas fa-circle-notch me-1 text-muted"></i>Search Radius
                    </label>
                    <select id="radiusSelect" class="form-select">
                        <option value="5">5 km</option>
                        <option value="10">10 km</option>
                        <option value="25" selected>25 km</option>
                        <option value="50">50 km</option>
                        <option value="100">100 km</option>
                    </select>
                </div>
                
                <div class="d-grid gap-2">
                    <button id="findNearbyNGOs" class="btn btn-info">
                        <i class="fas fa-building me-2"></i>Find Nearby NGOs
                    </button>
                    <button id="showDonations" class="btn btn-success">
                        <i class="fas fa-gift me-2"></i>Show Donations
                    </button>
                    <button id="clearMap" class="btn btn-outline-secondary">
                        <i class="fas fa-eraser me-2"></i>Clear Map
                    </button>
                </div>
            </div>
        </div>

        <!-- Nearby Donations List -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-semibold">
                        <i class="fas fa-gift me-2 text-success"></i>Nearby Donations
                    </h5>
                    <span class="badge bg-success" id="donationCount">0</span>
                </div>
            </div>
            <div class="card-body p-0">
                <div id="donationList" style="max-height: 500px; overflow-y: auto;">
                    <!-- Placeholder for donation markers -->
                    <div class="p-4 text-center text-muted">
                        <i class="fas fa-map-marker-alt fa-3x mb-3 opacity-50"></i>
                        <h6 class="fw-semibold mb-2">Donation Markers</h6>
                        <p class="small mb-0">
                            Click "Show Donations" to display nearby food donations on the map
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Map Features Info -->
<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="fas fa-info-circle me-2 text-primary"></i>Map Features
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-primary bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-search text-primary"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Search Locations</h6>
                                <p class="small text-muted mb-0">Find addresses and locations quickly</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-gift text-success"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Donation Markers</h6>
                                <p class="small text-muted mb-0">View all available food donations</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-building text-info"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">NGO Locations</h6>
                                <p class="small text-muted mb-0">Find nearby organizations</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="d-flex align-items-start">
                            <div class="bg-warning bg-opacity-10 rounded-circle p-2 me-3 mt-1">
                                <i class="fas fa-route text-warning"></i>
                            </div>
                            <div>
                                <h6 class="fw-semibold mb-1">Route Planning</h6>
                                <p class="small text-muted mb-0">Plan efficient pickup routes</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Map initialization placeholder
        // Map logic will be handled in JavaScript later
        
        let map;
        let donationMarkers = [];
        let ngoMarkers = [];
        let userMarker = null;

        // Initialize map function placeholder
        function initMap() {
            // Map initialization code will go here
            // This is a placeholder for future JavaScript implementation
            
            const mapContainer = document.getElementById('map');
            if (mapContainer) {
                // Placeholder: Map will be initialized here
                console.log('Map container ready for initialization');
            }
        }

        // Placeholder functions for map interactions
        document.getElementById('searchBtn')?.addEventListener('click', function() {
            const address = document.getElementById('addressInput')?.value;
            if (address) {
                console.log('Searching for:', address);
                // Search functionality will be implemented here
            }
        });

        document.getElementById('showDonations')?.addEventListener('click', function() {
            console.log('Loading donations...');
            // Donation loading functionality will be implemented here
            // This will populate the donationList with nearby donations
        });

        document.getElementById('findNearbyNGOs')?.addEventListener('click', function() {
            console.log('Finding nearby NGOs...');
            // NGO search functionality will be implemented here
        });

        document.getElementById('clearMap')?.addEventListener('click', function() {
            console.log('Clearing map...');
            // Clear markers functionality will be implemented here
            donationMarkers = [];
            ngoMarkers = [];
            document.getElementById('donationCount').textContent = '0';
        });

        // Map type switching
        document.getElementById('mapTypeRoadmap')?.addEventListener('click', function() {
            console.log('Switching to roadmap view');
            // Map type change functionality will be implemented here
        });

        document.getElementById('mapTypeSatellite')?.addEventListener('click', function() {
            console.log('Switching to satellite view');
            // Map type change functionality will be implemented here
        });

        document.getElementById('mapTypeTerrain')?.addEventListener('click', function() {
            console.log('Switching to terrain view');
            // Map type change functionality will be implemented here
        });

        // Initialize when page loads
        window.addEventListener('load', function() {
            // Wait for Google Maps API to load
            if (typeof google !== 'undefined' && google.maps) {
                initMap();
            } else {
                // Fallback: Initialize map when API loads
                setTimeout(function() {
                    if (typeof google !== 'undefined' && google.maps) {
                        initMap();
                    }
                }, 1000);
            }
        });
    </script>
    
    <!-- Google Maps API Script -->
    <!-- Replace YOUR_API_KEY with actual API key -->
    <script async defer 
            src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&libraries=places,geometry&callback=initMap">
    </script>
}

@section Styles {
    <style>
        #map {
            border-radius: 0 0 0.5rem 0.5rem;
        }

        #donationList {
            scrollbar-width: thin;
            scrollbar-color: #dee2e6 transparent;
        }

        #donationList::-webkit-scrollbar {
            width: 6px;
        }

        #donationList::-webkit-scrollbar-track {
            background: transparent;
        }

        #donationList::-webkit-scrollbar-thumb {
            background-color: #dee2e6;
            border-radius: 3px;
        }

        #donationList::-webkit-scrollbar-thumb:hover {
            background-color: #adb5bd;
        }

        @@media (max-width: 992px) {
            #map {
                height: 400px !important;
            }
        }

        @@media (max-width: 768px) {
            #map {
                height: 350px !important;
            }
        }
    </style>
}
