@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Smart Donation and Food Redistribution System - Connecting donors with NGOs to reduce food waste" />
    <title>@ViewData["Title"] - Smart Donation System</title>
    
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" 
          integrity="sha384-T3c6CoIi6uLrA9TneNEoa7RxnatzjcDSCmG1MXxSR1GAsXEV/Dwwykc2MPK8M2HN" 
          crossorigin="anonymous">
    
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" 
          integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" 
          crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="~/css/site.css" />
    
    <!-- Theme Initialization Script (Run before page render to prevent flash) -->
    <script>
        (function() {
            const theme = localStorage.getItem('smartDonationTheme') || 'light';
            if (theme === 'dark') {
                document.documentElement.setAttribute('data-theme', 'dark');
            }
        })();
    </script>
    
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark fixed-top home-navbar" id="homeNavbar">
            <div class="container-fluid px-4 px-lg-5">
                <!-- Brand -->
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon-wrapper me-3">
                        <i class="fas fa-hands-helping"></i>
                    </div>
                    <span class="brand-text">Smart Donation System</span>
                </a>
                
                <!-- Mobile Toggle -->
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" 
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Home -->
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home me-2"></i><span class="nav-link-text">Home</span>
                            </a>
                        </li>
                        
                        <!-- Donations -->
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Donations" asp-action="Index">
                                <i class="fas fa-gift me-2"></i><span class="nav-link-text">Donations</span>
                            </a>
                        </li>
                        
                        <!-- Map -->
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Map" asp-action="Index">
                                <i class="fas fa-map-marked-alt me-2"></i><span class="nav-link-text">Map</span>
                            </a>
                        </li>
                        
                        <!-- Notifications -->
                        <li class="nav-item">
                            <a class="nav-link px-3 position-relative" asp-area="" asp-controller="Notifications" asp-action="Index">
                                <i class="fas fa-bell me-2"></i><span class="nav-link-text">Notifications</span>
                            </a>
                        </li>
                        
                        <!-- Admin Menu -->
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-3" href="#" id="adminDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-shield me-2"></i><span class="nav-link-text">Admin</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow-lg" aria-labelledby="adminDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Users">
                                            <i class="fas fa-users me-2"></i>Manage Users
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="Donations">
                                            <i class="fas fa-gift me-2"></i>Manage Donations
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Admin" asp-action="NGOManagement">
                                            <i class="fas fa-building me-2"></i>Manage NGOs
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Analytics" asp-action="Dashboard">
                                            <i class="fas fa-chart-bar me-2"></i>Analytics Dashboard
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ML" asp-action="Analytics">
                                            <i class="fas fa-brain me-2"></i>AI Analytics
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        
                        <!-- NGO Menu -->
                        @if (User.IsInRole("NGO"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-3" href="#" id="ngoDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-building me-2"></i><span class="nav-link-text">NGO</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow-lg" aria-labelledby="ngoDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="NGO" asp-action="Dashboard">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="NGO" asp-action="AvailableDonations">
                                            <i class="fas fa-list me-2"></i>Available Donations
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="NGO" asp-action="MyRequests">
                                            <i class="fas fa-inbox me-2"></i>My Requests
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        
                        <!-- Donor Menu -->
                        @if (User.IsInRole("Donor"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle px-3" href="#" id="donorDropdown" role="button" 
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user me-2"></i><span class="nav-link-text">Donor</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark shadow-lg" aria-labelledby="donorDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Donor" asp-action="Dashboard">
                                            <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Donor" asp-action="MyDonations">
                                            <i class="fas fa-gift me-2"></i>My Donations
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Donor" asp-action="DonationRequests">
                                            <i class="fas fa-inbox me-2"></i>Requests
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Donations" asp-action="Create">
                                            <i class="fas fa-plus-circle me-2"></i>Create Donation
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                    </ul>
                    
                    <!-- Right Side: Theme Toggle, Notifications & Login -->
                    <ul class="navbar-nav ms-auto align-items-center gap-2">
                        <!-- Theme Toggle -->
                        <li class="nav-item">
                            <button type="button" class="theme-toggle btn-theme-toggle" id="themeToggle" aria-label="Toggle theme">
                                <i class="fas fa-moon" id="themeIcon"></i>
                            </button>
                        </li>
                        <partial name="_NotificationPartial" />
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="flex-shrink-0" style="margin-top: 0;">
        <div class="container-fluid px-4 py-4">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-light border-top mt-auto py-4">
        <div class="container-fluid px-4">
            <div class="row align-items-center">
                <div class="col-md-6 mb-3 mb-md-0">
                    <p class="mb-0 text-muted small">
                        <i class="fas fa-copyright me-1"></i>
                        @DateTime.Now.Year Smart Donation and Food Redistribution System. All rights reserved.
                    </p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0 text-muted small">
                        <i class="fas fa-heart text-danger me-1"></i>
                        Connecting donors with NGOs to reduce food waste
                    </p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <!-- jQuery (if needed for existing functionality) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" 
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" 
            crossorigin="anonymous"></script>
    
    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" 
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL" 
            crossorigin="anonymous"></script>
    
    <!-- SignalR - Load before other scripts that use it -->
    <script src="https://unpkg.com/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    
    <!-- Custom Site Scripts -->
    <script src="~/js/site.js"></script>
    
    <!-- Navbar Scroll Effect -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const navbar = document.getElementById('homeNavbar');
            
            if (navbar) {
                // Initial check for scroll position
                function handleScroll() {
                    if (window.scrollY > 50) {
                        navbar.classList.add('scrolled');
                    } else {
                        navbar.classList.remove('scrolled');
                    }
                }
                
                // Add scroll effect with throttling for performance
                let ticking = false;
                window.addEventListener('scroll', function() {
                    if (!ticking) {
                        window.requestAnimationFrame(function() {
                            handleScroll();
                            ticking = false;
                        });
                        ticking = true;
                    }
                });
                
                // Check initial scroll position
                handleScroll();
            }
            
            // Add active class to current page nav link
            const currentPath = window.location.pathname;
            const navLinks = document.querySelectorAll('.navbar-nav .nav-link');
            
            navLinks.forEach(link => {
                if (link.href) {
                    const linkPath = new URL(link.href).pathname;
                    if (linkPath === currentPath || 
                        (currentPath.startsWith(linkPath) && linkPath !== '/')) {
                        link.classList.add('active');
                    }
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
