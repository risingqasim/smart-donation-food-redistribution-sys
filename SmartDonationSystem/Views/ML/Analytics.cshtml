@{
    ViewData["Title"] = "AI Predictions";
}

<!-- Page Header -->
<div class="mb-4">
    <h2 class="fw-bold mb-1">
        <i class="fas fa-brain me-2 text-primary"></i>AI Food Demand Predictions
    </h2>
    <p class="text-muted mb-0">Machine learning predictions for food demand forecasting</p>
</div>

<!-- Predicted Food Demand -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="fas fa-chart-line me-2 text-primary"></i>Predicted Food Demand
                </h5>
            </div>
            <div class="card-body">
                <!-- Simple Chart Placeholder -->
                <div class="mb-4" style="height: 300px; background: linear-gradient(to top, #e3f2fd 0%, #f5f5f5 100%); border-radius: 0.5rem; display: flex; align-items: flex-end; justify-content: space-around; padding: 1rem;">
                    <div class="text-center" style="flex: 1;">
                        <div style="background: #dc3545; width: 60%; height: 65%; margin: 0 auto; border-radius: 0.25rem 0.25rem 0 0; min-height: 100px;"></div>
                        <small class="d-block mt-2 text-muted">High</small>
                    </div>
                    <div class="text-center" style="flex: 1;">
                        <div style="background: #ffc107; width: 60%; height: 45%; margin: 0 auto; border-radius: 0.25rem 0.25rem 0 0; min-height: 70px;"></div>
                        <small class="d-block mt-2 text-muted">Medium</small>
                    </div>
                    <div class="text-center" style="flex: 1;">
                        <div style="background: #198754; width: 60%; height: 25%; margin: 0 auto; border-radius: 0.25rem 0.25rem 0 0; min-height: 40px;"></div>
                        <small class="d-block mt-2 text-muted">Low</small>
                    </div>
                    <div class="text-center" style="flex: 1;">
                        <div style="background: #0dcaf0; width: 60%; height: 35%; margin: 0 auto; border-radius: 0.25rem 0.25rem 0 0; min-height: 55px;"></div>
                        <small class="d-block mt-2 text-muted">Normal</small>
                    </div>
                </div>

                <!-- Demand Summary -->
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-danger bg-opacity-10 rounded">
                            <h4 class="fw-bold text-danger mb-1">85%</h4>
                            <small class="text-muted">High Demand</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-warning bg-opacity-10 rounded">
                            <h4 class="fw-bold text-warning mb-1">60%</h4>
                            <small class="text-muted">Medium Demand</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-success bg-opacity-10 rounded">
                            <h4 class="fw-bold text-success mb-1">25%</h4>
                            <small class="text-muted">Low Demand</small>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center p-3 bg-info bg-opacity-10 rounded">
                            <h4 class="fw-bold text-info mb-1">40%</h4>
                            <small class="text-muted">Normal Supply</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Area Wise Shortage Alerts -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="fas fa-exclamation-triangle me-2 text-warning"></i>Area Shortage Alerts
                </h5>
            </div>
            <div class="card-body">
                <div class="list-group list-group-flush">
                    <div class="list-group-item border-0 px-0 mb-2">
                        <div class="d-flex align-items-start">
                            <div class="bg-danger bg-opacity-10 rounded-circle p-2 me-3">
                                <i class="fas fa-exclamation-circle text-danger"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-semibold mb-1">Downtown Area</h6>
                                <p class="small text-muted mb-0">Critical shortage - 95% demand</p>
                                <small class="text-danger">Immediate action required</small>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item border-0 px-0 mb-2">
                        <div class="d-flex align-items-start">
                            <div class="bg-warning bg-opacity-10 rounded-circle p-2 me-3">
                                <i class="fas fa-exclamation-triangle text-warning"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-semibold mb-1">Suburban Region</h6>
                                <p class="small text-muted mb-0">Moderate shortage - 70% demand</p>
                                <small class="text-warning">Monitor closely</small>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item border-0 px-0 mb-2">
                        <div class="d-flex align-items-start">
                            <div class="bg-info bg-opacity-10 rounded-circle p-2 me-3">
                                <i class="fas fa-info-circle text-info"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-semibold mb-1">Rural Areas</h6>
                                <p class="small text-muted mb-0">Stable supply - 45% demand</p>
                                <small class="text-info">No action needed</small>
                            </div>
                        </div>
                    </div>

                    <div class="list-group-item border-0 px-0">
                        <div class="d-flex align-items-start">
                            <div class="bg-success bg-opacity-10 rounded-circle p-2 me-3">
                                <i class="fas fa-check-circle text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-semibold mb-1">Coastal Region</h6>
                                <p class="small text-muted mb-0">Adequate supply - 30% demand</p>
                                <small class="text-success">Well supplied</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Prediction Explanation -->
<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h5 class="mb-0 fw-semibold">
                    <i class="fas fa-info-circle me-2 text-primary"></i>How Predictions Work
                </h5>
            </div>
            <div class="card-body">
                <div class="row g-4">
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">
                            <i class="fas fa-brain me-2 text-primary"></i>Machine Learning Model
                        </h6>
                        <p class="text-muted mb-3">
                            Our AI system analyzes historical donation patterns, NGO activity, seasonal trends, 
                            and geographic data to predict food demand levels across different areas.
                        </p>
                        <ul class="list-unstyled small text-muted">
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                Historical donation patterns
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                Seasonal and time-based trends
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                Geographic distribution analysis
                            </li>
                            <li class="mb-0">
                                <i class="fas fa-check text-success me-2"></i>
                                NGO capacity and response rates
                            </li>
                        </ul>
                    </div>
                    <div class="col-md-6">
                        <h6 class="fw-semibold mb-3">
                            <i class="fas fa-chart-bar me-2 text-primary"></i>Demand Levels Explained
                        </h6>
                        <div class="mb-3">
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-danger me-2">High</span>
                                <span class="small text-muted">Critical shortage expected - Immediate donations needed</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-warning me-2">Medium</span>
                                <span class="small text-muted">Moderate need - Monitor and prepare for donations</span>
                            </div>
                            <div class="d-flex align-items-center mb-2">
                                <span class="badge bg-success me-2">Low</span>
                                <span class="small text-muted">Adequate supply - No immediate action required</span>
                            </div>
                            <div class="d-flex align-items-center">
                                <span class="badge bg-info me-2">Normal</span>
                                <span class="small text-muted">Stable supply - Regular operations sufficient</span>
                            </div>
                        </div>
                        <p class="small text-muted mb-0">
                            <strong>Note:</strong> Predictions are updated daily based on the latest data. 
                            The model continuously learns from new donation patterns to improve accuracy.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Info -->
<div class="row g-4 mt-2">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="bg-primary bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                    <i class="fas fa-calendar-alt fa-2x text-primary"></i>
                </div>
                <h6 class="fw-semibold mb-2">Prediction Period</h6>
                <p class="small text-muted mb-0">Next 7 days forecast</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="bg-success bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                    <i class="fas fa-sync-alt fa-2x text-success"></i>
                </div>
                <h6 class="fw-semibold mb-2">Update Frequency</h6>
                <p class="small text-muted mb-0">Daily automatic updates</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center">
                <div class="bg-info bg-opacity-10 rounded-circle p-3 d-inline-flex mb-3">
                    <i class="fas fa-percentage fa-2x text-info"></i>
                </div>
                <h6 class="fw-semibold mb-2">Model Accuracy</h6>
                <p class="small text-muted mb-0">~87% prediction accuracy</p>
            </div>
        </div>
    </div>
</div>
