@model SmartDonationSystem.Controllers.AdminAnalyticsViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    var monthlyTrends = ViewBag.MonthlyTrends as List<SmartDonationSystem.Models.MonthlyTrend> ?? new List<SmartDonationSystem.Models.MonthlyTrend>();
    var foodTypeData = ViewBag.FoodTypeData as List<SmartDonationSystem.Models.FoodTypeDistribution> ?? new List<SmartDonationSystem.Models.FoodTypeDistribution>();
}

<style>
    :root {
        --primary-blue: #4f46e5;
        --indigo: #6366f1;
        --dark-gray: #1f2937;
        --medium-gray: #6b7280;
        --light-gray: #f3f4f6;
        --card-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
        --card-shadow-hover: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    body {
        background-color: #f9fafb;
    }

    .dashboard-header-wrapper {
        margin: -1.5rem -1rem 2rem -1rem;
        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--indigo) 100%);
    }

    .dashboard-header {
        color: white;
        padding: 2rem 0;
    }

    @@media (max-width: 768px) {
        .dashboard-header-wrapper {
            margin: -1rem -1rem 1.5rem -1rem;
        }
        
        .dashboard-header {
            padding: 1.5rem 0;
        }
        
        .dashboard-header h1 {
            font-size: 1.5rem;
        }
        
        .stat-card .stat-value {
            font-size: 1.5rem;
        }
    }

    .dashboard-header h1 {
        font-size: 2rem;
        font-weight: 700;
        margin: 0;
    }

    .dashboard-header p {
        opacity: 0.9;
        margin: 0.5rem 0 0 0;
    }

    .stat-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
        border-left: 4px solid;
        height: 100%;
    }

    .stat-card:hover {
        box-shadow: var(--card-shadow-hover);
        transform: translateY(-2px);
    }

    .stat-card.donation { border-left-color: #10b981; }
    .stat-card.ngo { border-left-color: #3b82f6; }
    .stat-card.donor { border-left-color: #8b5cf6; }
    .stat-card.pending { border-left-color: #f59e0b; }

    .stat-card .stat-icon {
        width: 56px;
        height: 56px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin-bottom: 1rem;
    }

    .stat-card.donation .stat-icon { background-color: #d1fae5; color: #10b981; }
    .stat-card.ngo .stat-icon { background-color: #dbeafe; color: #3b82f6; }
    .stat-card.donor .stat-icon { background-color: #ede9fe; color: #8b5cf6; }
    .stat-card.pending .stat-icon { background-color: #fef3c7; color: #f59e0b; }

    .stat-card .stat-value {
        font-size: 2rem;
        font-weight: 700;
        color: var(--dark-gray);
        margin: 0.5rem 0;
    }

    .stat-card .stat-label {
        color: var(--medium-gray);
        font-size: 0.875rem;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .chart-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--card-shadow);
        margin-bottom: 1.5rem;
    }

    .chart-card h3 {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--dark-gray);
        margin-bottom: 1.5rem;
    }

    .sidebar-nav {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--card-shadow);
        margin-bottom: 1.5rem;
    }

    .sidebar-nav h3 {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--dark-gray);
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid var(--light-gray);
    }

    .nav-item-admin {
        display: block;
        padding: 0.75rem 1rem;
        margin-bottom: 0.5rem;
        color: var(--medium-gray);
        text-decoration: none;
        border-radius: 8px;
        transition: all 0.2s ease;
        font-weight: 500;
    }

    .nav-item-admin:hover {
        background-color: var(--light-gray);
        color: var(--primary-blue);
    }

    .nav-item-admin.active {
        background-color: #eef2ff;
        color: var(--primary-blue);
    }

    .nav-item-admin i {
        width: 20px;
        margin-right: 0.75rem;
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 1rem;
        margin-top: 1.5rem;
    }

    .quick-action-btn {
        background: white;
        border: 2px solid var(--light-gray);
        border-radius: 8px;
        padding: 1rem;
        text-align: center;
        text-decoration: none;
        color: var(--dark-gray);
        transition: all 0.2s ease;
        display: block;
    }

    .quick-action-btn:hover {
        border-color: var(--primary-blue);
        color: var(--primary-blue);
        transform: translateY(-2px);
        box-shadow: var(--card-shadow);
    }

    .quick-action-btn i {
        display: block;
        font-size: 1.5rem;
        margin-bottom: 0.5rem;
        color: var(--primary-blue);
    }

    .recent-item {
        padding: 1rem;
        border-bottom: 1px solid var(--light-gray);
    }

    .recent-item:last-child {
        border-bottom: none;
    }

    .empty-state {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--medium-gray);
    }

    .empty-state i {
        font-size: 3rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
</style>

<div class="dashboard-header-wrapper">
    <div class="dashboard-header">
        <div class="container-fluid px-4">
            <h1><i class="fas fa-tachometer-alt me-2"></i>Admin Dashboard</h1>
            <p>Welcome back! Here's what's happening with your donation system.</p>
        </div>
    </div>
</div>

<div class="container-fluid px-4">
    <div class="row">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 mb-4">
            <div class="sidebar-nav">
                <h3><i class="fas fa-bars me-2"></i>Quick Navigation</h3>
                <a asp-action="Dashboard" class="nav-item-admin active">
                    <i class="fas fa-tachometer-alt"></i>Dashboard
                </a>
                <a asp-action="Users" class="nav-item-admin">
                    <i class="fas fa-users"></i>Manage Users
                </a>
                <a asp-action="Donations" class="nav-item-admin">
                    <i class="fas fa-gift"></i>Manage Donations
                </a>
                <a asp-action="NGOManagement" class="nav-item-admin">
                    <i class="fas fa-building"></i>Manage NGOs
                </a>
                <a asp-controller="Analytics" asp-action="Dashboard" class="nav-item-admin">
                    <i class="fas fa-chart-bar"></i>Analytics
                </a>
            </div>

            <!-- Quick Actions -->
            <div class="chart-card">
                <h3><i class="fas fa-bolt me-2"></i>Quick Actions</h3>
                <div class="quick-actions">
                    <a asp-action="Users" class="quick-action-btn">
                        <i class="fas fa-users"></i>
                        <span>Users</span>
                    </a>
                    <a asp-action="Donations" class="quick-action-btn">
                        <i class="fas fa-gift"></i>
                        <span>Donations</span>
                    </a>
                    <a asp-action="NGOManagement" class="quick-action-btn">
                        <i class="fas fa-building"></i>
                        <span>NGOs</span>
                    </a>
                    <a asp-controller="Analytics" asp-action="Dashboard" class="quick-action-btn">
                        <i class="fas fa-chart-line"></i>
                        <span>Analytics</span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-9">
            <!-- Statistics Cards -->
            <div class="row g-4 mb-4">
                <div class="col-md-6 col-lg-3">
                    <div class="stat-card donation">
                        <div class="stat-icon">
                            <i class="fas fa-gift"></i>
                        </div>
                        <div class="stat-label">Total Donations</div>
                        <div class="stat-value">@Model.TotalDonations</div>
                        <small class="text-muted">
                            <i class="fas fa-check-circle me-1"></i>@Model.CollectedDonations collected
                        </small>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="stat-card ngo">
                        <div class="stat-icon">
                            <i class="fas fa-building"></i>
                        </div>
                        <div class="stat-label">Total NGOs</div>
                        <div class="stat-value">@Model.TotalNGOs</div>
                        <small class="text-muted">
                            <i class="fas fa-handshake me-1"></i>Active organizations
                        </small>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="stat-card donor">
                        <div class="stat-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="stat-label">Total Donors</div>
                        <div class="stat-value">@Model.TotalUsers</div>
                        <small class="text-muted">
                            <i class="fas fa-user-plus me-1"></i>@Model.RecentUsers.Count new this month
                        </small>
                    </div>
                </div>

                <div class="col-md-6 col-lg-3">
                    <div class="stat-card pending">
                        <div class="stat-icon">
                            <i class="fas fa-clock"></i>
                        </div>
                        <div class="stat-label">Pending Requests</div>
                        <div class="stat-value">@Model.PendingRequests</div>
                        <small class="text-muted">
                            <i class="fas fa-exclamation-circle me-1"></i>Requires attention
                        </small>
                    </div>
                </div>
            </div>

            <!-- Charts Row -->
            <div class="row">
                <!-- Donations per Month Chart -->
                <div class="col-lg-6">
                    <div class="chart-card">
                        <h3><i class="fas fa-chart-line me-2 text-primary"></i>Donations Per Month</h3>
                        <canvas id="monthlyDonationsChart" height="250"></canvas>
                    </div>
                </div>

                <!-- Food Redistribution Stats Chart -->
                <div class="col-lg-6">
                    <div class="chart-card">
                        <h3><i class="fas fa-chart-pie me-2 text-primary"></i>Food Type Distribution</h3>
                        <canvas id="foodTypeChart" height="250"></canvas>
                    </div>
                </div>
            </div>

            <!-- Recent Activity Row -->
            <div class="row">
                <!-- Recent Donations -->
                <div class="col-lg-6">
                    <div class="chart-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="mb-0"><i class="fas fa-gift me-2 text-primary"></i>Recent Donations</h3>
                            <a asp-action="Donations" class="btn btn-sm btn-outline-primary">View All</a>
                        </div>
                        @if (Model.RecentDonations.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var donation in Model.RecentDonations.Take(5))
                                {
                                    var statusClass = donation.Status switch
                                    {
                                        "Available" => "success",
                                        "Reserved" => "warning",
                                        "Collected" => "info",
                                        _ => "secondary"
                                    };
                                    <div class="recent-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1 fw-semibold">@donation.Title</h6>
                                                <small class="text-muted d-block">
                                                    <i class="fas fa-user me-1"></i>@donation.Donor?.FirstName @donation.Donor?.LastName
                                                </small>
                                                <div class="mt-2">
                                                    <span class="badge bg-@statusClass">@donation.Status</span>
                                                    <span class="badge bg-secondary ms-1">@donation.FoodType</span>
                                                </div>
                                            </div>
                                            <small class="text-muted">@donation.CreatedAt.ToString("MMM dd")</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-inbox"></i>
                                <p>No recent donations</p>
                            </div>
                        }
                    </div>
                </div>

                <!-- Pending Requests -->
                <div class="col-lg-6">
                    <div class="chart-card">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="mb-0">
                                <i class="fas fa-clock me-2 text-warning"></i>Pending Requests
                                @if (Model.PendingRequests > 0)
                                {
                                    <span class="badge bg-warning ms-2">@Model.PendingRequests</span>
                                }
                            </h3>
                            <a asp-action="Donations" class="btn btn-sm btn-outline-primary">Manage</a>
                        </div>
                        @{
                            var pendingDonations = Model.RecentDonations.Where(d => d.Status == "Available").Take(5).ToList();
                        }
                        @if (pendingDonations.Any())
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var donation in pendingDonations)
                                {
                                    <div class="recent-item">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1">
                                                <h6 class="mb-1 fw-semibold">@donation.Title</h6>
                                                <small class="text-muted d-block">
                                                    <i class="fas fa-user me-1"></i>@donation.Donor?.FirstName @donation.Donor?.LastName
                                                </small>
                                                <div class="mt-2">
                                                    <span class="badge bg-info">@donation.FoodType</span>
                                                    <span class="badge bg-secondary ms-1">@donation.Quantity @donation.Unit</span>
                                                </div>
                                            </div>
                                            <small class="text-muted">@donation.CreatedAt.ToString("MMM dd")</small>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="empty-state">
                                <i class="fas fa-check-circle text-success"></i>
                                <p>No pending requests</p>
                                <small>All donations are processed</small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <script>
        // Monthly Donations Chart
        const monthlyData = @Html.Raw(Json.Serialize(monthlyTrends));
        const monthlyCtx = document.getElementById('monthlyDonationsChart').getContext('2d');
        
        new Chart(monthlyCtx, {
            type: 'line',
            data: {
                labels: monthlyData.map(item => item.month),
                datasets: [{
                    label: 'Donations',
                    data: monthlyData.map(item => item.donationCount),
                    borderColor: '#4f46e5',
                    backgroundColor: 'rgba(79, 70, 229, 0.1)',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    pointBackgroundColor: '#4f46e5',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        },
                        grid: {
                            color: 'rgba(0, 0, 0, 0.05)'
                        }
                    },
                    x: {
                        grid: {
                            display: false
                        }
                    }
                }
            }
        });

        // Food Type Distribution Chart
        const foodData = @Html.Raw(Json.Serialize(foodTypeData));
        const foodCtx = document.getElementById('foodTypeChart').getContext('2d');
        
        const colorPalette = [
            '#4f46e5', '#10b981', '#f59e0b', '#ef4444', 
            '#8b5cf6', '#06b6d4', '#ec4899', '#6366f1'
        ];

        new Chart(foodCtx, {
            type: 'doughnut',
            data: {
                labels: foodData.map(item => item.foodType),
                datasets: [{
                    data: foodData.map(item => item.count),
                    backgroundColor: colorPalette.slice(0, foodData.length),
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 15,
                            usePointStyle: true
                        }
                    }
                }
            }
        });
    </script>
}
