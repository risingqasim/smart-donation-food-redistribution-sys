@model SmartDonationSystem.Controllers.AdminAnalyticsViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">Admin Dashboard</h1>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.TotalUsers</h4>
                        <p class="card-text">Total Users</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-users fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.TotalDonations</h4>
                        <p class="card-text">Total Donations</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-gift fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.TotalNGOs</h4>
                        <p class="card-text">Total NGOs</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-building fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <h4 class="card-title">@Model.AvailableDonations</h4>
                        <p class="card-text">Available Donations</p>
                    </div>
                    <div class="align-self-center">
                        <i class="fas fa-check-circle fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Additional Statistics -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-success">@Model.CollectedDonations</h5>
                <p class="card-text">Collected Donations</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-primary">@Model.TotalDonationRequests</h5>
                <p class="card-text">Total Requests</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-warning">@Model.PendingRequests</h5>
                <p class="card-text">Pending Requests</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card">
            <div class="card-body text-center">
                <h5 class="card-title text-success">@Model.ApprovedRequests</h5>
                <p class="card-text">Approved Requests</p>
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Recent Donations</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentDonations.Any())
                {
                    <div class="list-group">
                        @foreach (var donation in Model.RecentDonations)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@donation.Title</h6>
                                    <small>@donation.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <p class="mb-1">@donation.Description</p>
                                <small>
                                    By: @donation.Donor?.FirstName @donation.Donor?.LastName | 
                                    Status: <span class="badge bg-@(donation.Status == "Available" ? "success" : "warning")">@donation.Status</span>
                                </small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No recent donations.</p>
                }
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Recent Users</h5>
            </div>
            <div class="card-body">
                @if (Model.RecentUsers.Any())
                {
                    <div class="list-group">
                        @foreach (var user in Model.RecentUsers)
                        {
                            <div class="list-group-item">
                                <div class="d-flex w-100 justify-content-between">
                                    <h6 class="mb-1">@user.FirstName @user.LastName</h6>
                                    <small>@user.CreatedAt.ToString("MMM dd, yyyy")</small>
                                </div>
                                <p class="mb-1">@user.Email</p>
                                <small>Joined: @user.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No recent users.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Quick Actions</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <a asp-action="Users" class="btn btn-primary btn-block">Manage Users</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-action="Donations" class="btn btn-success btn-block">View Donations</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-action="NGOManagement" class="btn btn-info btn-block">Manage NGOs</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Donations" asp-action="Index" class="btn btn-secondary btn-block">View All Donations</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
