<!-- NGOs Report -->
@if (Model?.ReportType?.ToLower() == "ngos" && Model?.NGOReport != null)
{
    <div class="report-container">
        <h3 class="mb-3">
            <i class="fas fa-building text-primary me-2"></i>NGO Report
            <small class="text-muted">(@Model.NGOReport.StartDate.ToString("MMM dd, yyyy") - @Model.NGOReport.EndDate.ToString("MMM dd, yyyy"))</small>
        </h3>
        
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Total NGOs</div>
                    <div class="stat-value">@Model.NGOReport.TotalNGOs</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Active NGOs</div>
                    <div class="stat-value">@Model.NGOReport.ActiveNGOs</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Donations Received</div>
                    <div class="stat-value">@Model.NGOReport.TotalDonationsReceived</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-label">Requests Made</div>
                    <div class="stat-value">@Model.NGOReport.TotalRequestsMade</div>
                </div>
            </div>
        </div>

        @if (Model.NGOReport.NGODetails != null && Model.NGOReport.NGODetails.Any())
        {
            <h4 class="mb-3">NGO Details</h4>
            <div class="table-responsive">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Location</th>
                            <th>Capacity</th>
                            <th>Donations Received</th>
                            <th>Requests Made</th>
                            <th>Created</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ngo in Model.NGOReport.NGODetails)
                        {
                            <tr>
                                <td>@(ngo?.Name ?? "Unknown")</td>
                                <td>@(ngo?.Location ?? "Unknown")</td>
                                <td>@(ngo?.Capacity ?? 0)</td>
                                <td>@(ngo?.DonationsReceived ?? 0)</td>
                                <td>@(ngo?.RequestsMade ?? 0)</td>
                                <td>@(ngo?.CreatedAt.ToString("MMM dd, yyyy") ?? "Unknown")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-building"></i>
                <p>No NGO data available for the selected date range</p>
            </div>
        }
    </div>
}

