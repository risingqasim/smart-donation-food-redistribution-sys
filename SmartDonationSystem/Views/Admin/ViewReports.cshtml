<!-- Empty State -->
@if (Model == null || 
     (Model.ReportType?.ToLower() == "overview" && Model.DonationReport == null && Model.UserReport == null && Model.AnalyticsReport == null) ||
     (Model.ReportType?.ToLower() == "donations" && Model.DonationReport == null) ||
     (Model.ReportType?.ToLower() == "users" && Model.UserReport == null) ||
     (Model.ReportType?.ToLower() == "ngos" && Model.NGOReport == null) ||
     (Model.ReportType?.ToLower() == "analytics" && Model.AnalyticsReport == null))
{
    <div class="report-container">
        <div class="empty-state">
            <i class="fas fa-chart-line"></i>
            <h4>No Data Available</h4>
            <p>No report data is available for the selected criteria. Please try adjusting your date range or report type.</p>
            <a asp-action="ViewReports" asp-route-reportType="overview" class="btn btn-primary mt-3">
                <i class="fas fa-refresh me-1"></i>Refresh Report
            </a>
        </div>
    </div>
}

