@model SmartDonationSystem.Models.NGO
@{
    Layout = "_NGOLayout";
    ViewData["Title"] = "Setup NGO Profile";
}

<style>
    :root {
        --teal-primary: #14b8a6;
        --teal-dark: #0f766e;
        --blue-primary: #3b82f6;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-600: #4b5563;
        --gray-800: #1f2937;
    }

    .setup-container {
        max-width: 800px;
        margin: 2rem auto;
        padding: 0 1rem;
    }

    .setup-header {
        background: linear-gradient(135deg, var(--teal-primary) 0%, var(--blue-primary) 100%);
        color: white;
        padding: 2rem;
        border-radius: 12px 12px 0 0;
        text-align: center;
    }

    .setup-header h1 {
        font-size: 1.75rem;
        font-weight: 600;
        margin: 0 0 0.5rem 0;
    }

    .setup-header p {
        opacity: 0.95;
        margin: 0;
        font-size: 0.95rem;
    }

    .setup-card {
        background: white;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 2rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        font-weight: 600;
        color: var(--gray-800);
        margin-bottom: 0.5rem;
        display: block;
    }

    .form-label .required {
        color: #ef4444;
        margin-left: 0.25rem;
    }

    .form-control {
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        padding: 0.75rem;
        font-size: 1rem;
        transition: all 0.2s ease;
    }

    .form-control:focus {
        border-color: var(--teal-primary);
        box-shadow: 0 0 0 3px rgba(20, 184, 166, 0.1);
        outline: none;
    }

    .form-text {
        font-size: 0.875rem;
        color: var(--gray-600);
        margin-top: 0.25rem;
    }

    .btn-teal {
        background-color: var(--teal-primary);
        border-color: var(--teal-primary);
        color: white;
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.2s ease;
    }

    .btn-teal:hover {
        background-color: var(--teal-dark);
        border-color: var(--teal-dark);
        color: white;
    }

    .btn-outline-secondary {
        border-color: var(--gray-200);
        color: var(--gray-600);
        padding: 0.75rem 2rem;
        font-weight: 600;
        border-radius: 8px;
    }

    .btn-outline-secondary:hover {
        background-color: var(--gray-100);
        border-color: var(--gray-300);
    }

    .alert {
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

    .text-danger {
        color: #ef4444;
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }
</style>

<div class="setup-container">
    <div class="setup-header">
        <h1><i class="fas fa-building me-2"></i>Setup Your NGO Profile</h1>
        <p>Complete your organization profile to start managing donations</p>
    </div>

    <div class="setup-card">
        @if (TempData["Info"] != null)
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i>@TempData["Info"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle me-2"></i>@TempData["Error"]
            </div>
        }

        <form asp-action="SetupProfile" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label">
                            Organization Name <span class="required">*</span>
                        </label>
                        <input asp-for="Name" class="form-control" placeholder="Enter your organization name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Location" class="form-label">
                            Location <span class="required">*</span>
                        </label>
                        <input asp-for="Location" class="form-control" placeholder="Street, City, State, ZIP" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                        <small class="form-text">Full address where your organization is located</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Contact" class="form-label">
                            Contact Email/Phone <span class="required">*</span>
                        </label>
                        <input asp-for="Contact" class="form-control" placeholder="email@example.com or phone number" />
                        <span asp-validation-for="Contact" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Capacity" class="form-label">
                            Capacity <span class="required">*</span>
                        </label>
                        <input asp-for="Capacity" type="number" class="form-control" placeholder="Number of people you serve" min="1" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                        <small class="form-text">How many people can your organization serve?</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="RegistrationNumber" class="form-label">
                            Registration Number
                        </label>
                        <input asp-for="RegistrationNumber" class="form-control" placeholder="Optional registration number" />
                        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Description" class="form-label">
                    Description
                </label>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Tell us about your organization and its mission..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
                <small class="form-text">Brief description of your organization's mission and activities</small>
            </div>

            <div class="form-group">
                <label asp-for="Website" class="form-label">
                    Website
                </label>
                <input asp-for="Website" type="url" class="form-control" placeholder="https://www.example.com" />
                <span asp-validation-for="Website" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Latitude" class="form-label">
                            Latitude (Optional)
                        </label>
                        <input asp-for="Latitude" type="number" step="any" class="form-control" placeholder="e.g., 40.7128" />
                        <span asp-validation-for="Latitude" class="text-danger"></span>
                        <small class="form-text">For map integration and nearby donations</small>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Longitude" class="form-label">
                            Longitude (Optional)
                        </label>
                        <input asp-for="Longitude" type="number" step="any" class="form-control" placeholder="e.g., -74.0060" />
                        <span asp-validation-for="Longitude" class="text-danger"></span>
                        <small class="form-text">For map integration and nearby donations</small>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Cancel
                </a>
                <button type="submit" class="btn btn-teal">
                    <i class="fas fa-check me-2"></i>Create Profile
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

