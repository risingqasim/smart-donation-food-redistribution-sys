@model SmartDonationSystem.Controllers.NGODashboardViewModel

@{
    ViewData["Title"] = "NGO Dashboard";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">NGO Dashboard - @Model.NGO.Name</h1>
    </div>
</div>

<!-- NGO Info Card -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Organization Information</h5>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Contact:</strong> @Model.NGO.Contact</p>
                        <p><strong>Location:</strong> @Model.NGO.Location</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Capacity:</strong> @Model.NGO.Capacity</p>
                        <p><strong>Registration:</strong> @Model.NGO.RegistrationNumber</p>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.NGO.Description))
                {
                    <p><strong>Description:</strong> @Model.NGO.Description</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.AvailableDonations.Count</h4>
                <p class="card-text">Available Donations</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.MyRequests.Count</h4>
                <p class="card-text">My Requests</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.ClaimedDonations.Count</h4>
                <p class="card-text">Claimed Donations</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.MyRequests.Count(r => r.Status == "Approved")</h4>
                <p class="card-text">Approved Requests</p>
            </div>
        </div>
    </div>
</div>

<!-- Available Donations -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Available Donations</h5>
                <a asp-action="AvailableDonations" class="btn btn-primary btn-sm">View All</a>
            </div>
            <div class="card-body">
                @if (Model.AvailableDonations.Any())
                {
                    <div class="row">
                        @foreach (var donation in Model.AvailableDonations.Take(6))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">@donation.Title</h6>
                                        <p class="card-text">@donation.Description</p>
                                        <p class="card-text">
                                            <small class="text-muted">
                                                <strong>Type:</strong> @donation.FoodType | 
                                                <strong>Quantity:</strong> @donation.Quantity @donation.Unit |
                                                <strong>Expires:</strong> @donation.ExpiryDate.ToString("MMM dd, yyyy")
                                            </small>
                                        </p>
                                        <div class="d-flex justify-content-between">
                                            <a asp-action="DonationDetails" asp-route-id="@donation.Id" 
                                               class="btn btn-sm btn-outline-primary">View Details</a>
                                            <button type="button" class="btn btn-sm btn-success" 
                                                    data-bs-toggle="modal" data-bs-target="#requestModal" 
                                                    data-donation-id="@donation.Id" data-donation-title="@donation.Title">
                                                Request
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No available donations at the moment.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- My Requests -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">My Recent Requests</h5>
                <a asp-action="MyRequests" class="btn btn-primary btn-sm">View All</a>
            </div>
            <div class="card-body">
                @if (Model.MyRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Donation</th>
                                    <th>Status</th>
                                    <th>Requested</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.MyRequests.Take(5))
                                {
                                    <tr>
                                        <td>@request.Donation?.Title</td>
                                        <td>
                                            <span class="badge bg-@(request.Status == "Approved" ? "success" : request.Status == "Rejected" ? "danger" : "warning")">
                                                @request.Status
                                            </span>
                                        </td>
                                        <td>@request.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <a asp-action="DonationDetails" asp-route-id="@request.DonationId" 
                                               class="btn btn-sm btn-outline-primary">View</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted">No requests made yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Request Modal -->
<div class="modal fade" id="requestModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Request Donation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RequestDonation" method="post">
                <div class="modal-body">
                    <input type="hidden" id="donationId" name="donationId" />
                    <div class="mb-3">
                        <label for="message" class="form-label">Message to Donor</label>
                        <textarea class="form-control" id="message" name="message" rows="3" 
                                  placeholder="Explain why your organization needs this donation..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Submit Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('requestModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var donationId = button.getAttribute('data-donation-id');
            var donationTitle = button.getAttribute('data-donation-title');
            
            document.getElementById('donationId').value = donationId;
            document.querySelector('#requestModal .modal-title').textContent = 'Request: ' + donationTitle;
        });
    </script>
}
