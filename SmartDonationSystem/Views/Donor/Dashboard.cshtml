@model SmartDonationSystem.Controllers.DonorDashboardViewModel

@{
    ViewData["Title"] = "Donor Dashboard";
}

<h1>Donor Dashboard</h1>

<!-- Statistics Cards -->
<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.TotalDonations</h4>
                <p class="card-text">Total Donations</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.AvailableDonations</h4>
                <p class="card-text">Available</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-warning text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.ReservedDonations</h4>
                <p class="card-text">Reserved</p>
            </div>
        </div>
    </div>
    <div class="col-md-3 mb-3">
        <div class="card bg-info text-white">
            <div class="card-body text-center">
                <h4 class="card-title">@Model.CollectedDonations</h4>
                <p class="card-text">Collected</p>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions -->
<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Quick Actions</h5>
                <div class="row">
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Donations" asp-action="Create" class="btn btn-success btn-block">Create New Donation</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-action="MyDonations" class="btn btn-primary btn-block">My Donations</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-action="DonationRequests" class="btn btn-warning btn-block">View Requests</a>
                    </div>
                    <div class="col-md-3 mb-2">
                        <a asp-controller="Donations" asp-action="Index" class="btn btn-secondary btn-block">All Donations</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Pending Requests -->
@if (Model.PendingRequests.Any())
{
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Pending Requests (@Model.PendingRequests.Count)</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Donation</th>
                                    <th>NGO</th>
                                    <th>Message</th>
                                    <th>Requested</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in Model.PendingRequests)
                                {
                                    <tr>
                                        <td>
                                            <strong>@request.Donation?.Title</strong>
                                            <br>
                                            <small class="text-muted">@request.Donation?.FoodType - @request.Donation?.Quantity @request.Donation?.Unit</small>
                                        </td>
                                        <td>@request.NGO?.Name</td>
                                        <td>@request.Message</td>
                                        <td>@request.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <button type="button" class="btn btn-sm btn-success" 
                                                        data-bs-toggle="modal" data-bs-target="#approveModal" 
                                                        data-request-id="@request.Id" data-donation-title="@request.Donation?.Title">
                                                    Approve
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" 
                                                        data-bs-toggle="modal" data-bs-target="#rejectModal" 
                                                        data-request-id="@request.Id" data-donation-title="@request.Donation?.Title">
                                                    Reject
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Recent Donations -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Recent Donations</h5>
                <a asp-action="MyDonations" class="btn btn-primary btn-sm">View All</a>
            </div>
            <div class="card-body">
                @if (Model.RecentDonations.Any())
                {
                    <div class="row">
                        @foreach (var donation in Model.RecentDonations)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <h6 class="card-title">@donation.Title</h6>
                                        <p class="card-text">@donation.Description</p>
                                        <p class="card-text">
                                            <small class="text-muted">
                                                <strong>Type:</strong> @donation.FoodType | 
                                                <strong>Quantity:</strong> @donation.Quantity @donation.Unit |
                                                <strong>Status:</strong> 
                                                <span class="badge bg-@(donation.Status == "Available" ? "success" : donation.Status == "Reserved" ? "warning" : "secondary")">@donation.Status</span>
                                            </small>
                                        </p>
                                        <div class="d-flex justify-content-between">
                                            <a asp-controller="Donations" asp-action="Details" asp-route-id="@donation.Id" 
                                               class="btn btn-sm btn-outline-primary">View</a>
                                            <a asp-controller="Donations" asp-action="Edit" asp-route-id="@donation.Id" 
                                               class="btn btn-sm btn-outline-secondary">Edit</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No donations created yet.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- Approve Modal -->
<div class="modal fade" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Approve Donation Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="ApproveRequest" method="post">
                <div class="modal-body">
                    <input type="hidden" id="approveRequestId" name="requestId" />
                    <div class="mb-3">
                        <label for="approveResponseMessage" class="form-label">Response Message (Optional)</label>
                        <textarea class="form-control" id="approveResponseMessage" name="responseMessage" rows="3" 
                                  placeholder="Add a message for the NGO..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Approve Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Reject Donation Request</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-action="RejectRequest" method="post">
                <div class="modal-body">
                    <input type="hidden" id="rejectRequestId" name="requestId" />
                    <div class="mb-3">
                        <label for="rejectResponseMessage" class="form-label">Reason for Rejection</label>
                        <textarea class="form-control" id="rejectResponseMessage" name="responseMessage" rows="3" 
                                  placeholder="Explain why you're rejecting this request..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Reject Request</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Approve modal
        document.getElementById('approveModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var requestId = button.getAttribute('data-request-id');
            var donationTitle = button.getAttribute('data-donation-title');
            
            document.getElementById('approveRequestId').value = requestId;
            document.querySelector('#approveModal .modal-title').textContent = 'Approve Request for: ' + donationTitle;
        });

        // Reject modal
        document.getElementById('rejectModal').addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var requestId = button.getAttribute('data-request-id');
            var donationTitle = button.getAttribute('data-donation-title');
            
            document.getElementById('rejectRequestId').value = requestId;
            document.querySelector('#rejectModal .modal-title').textContent = 'Reject Request for: ' + donationTitle;
        });
    </script>
}
