@model IEnumerable<SmartDonationSystem.Models.Donation>

@{
    ViewData["Title"] = "Donations";
}

<h1>Donations</h1>

<p>
    @if (User.IsInRole("Donor") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary">Create New Donation</a>
    }
</p>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card">
                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">@item.Description</p>
                    <p class="card-text">
                        <small class="text-muted">
                            Food Type: @item.FoodType | Quantity: @item.Quantity @item.Unit
                        </small>
                    </p>
                    <p class="card-text">
                        <small class="text-muted">
                            Status: <span class="badge bg-@(item.Status == "Available" ? "success" : item.Status == "Reserved" ? "warning" : item.Status == "Collected" ? "success" : "secondary")">@item.Status</span>
                        </small>
                    </p>
                    <p class="card-text">
                        <small class="text-muted">
                            Expires: @item.ExpiryDate.ToString("MMM dd, yyyy")
                        </small>
                    </p>
                    <div class="d-flex justify-content-between">
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">View Details</a>
                        @if ((User.IsInRole("Donor") && item.DonorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) || User.IsInRole("Admin"))
                        {
                            <div>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm">Delete</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>
