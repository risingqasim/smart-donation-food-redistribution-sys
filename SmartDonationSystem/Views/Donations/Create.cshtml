@model SmartDonationSystem.Models.Donation

@{
    ViewData["Title"] = "Create Donation";
}

<h1>Create Donation</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="FoodType" class="control-label"></label>
                        <select asp-for="FoodType" class="form-control">
                            <option value="">Select Food Type</option>
                            <option value="Vegetables">Vegetables</option>
                            <option value="Fruits">Fruits</option>
                            <option value="Grains">Grains</option>
                            <option value="Dairy">Dairy</option>
                            <option value="Meat">Meat</option>
                            <option value="Bakery">Bakery</option>
                            <option value="Beverages">Beverages</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="FoodType" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group mb-3">
                        <label asp-for="ExpiryDate" class="control-label"></label>
                        <input asp-for="ExpiryDate" class="form-control" type="date" />
                        <span asp-validation-for="ExpiryDate" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Quantity" class="control-label"></label>
                        <input asp-for="Quantity" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Quantity" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Unit" class="control-label"></label>
                        <select asp-for="Unit" class="form-control">
                            <option value="">Select Unit</option>
                            <option value="pieces">Pieces</option>
                            <option value="kg">Kilograms</option>
                            <option value="liters">Liters</option>
                            <option value="boxes">Boxes</option>
                            <option value="bags">Bags</option>
                        </select>
                        <span asp-validation-for="Unit" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group mb-3">
                        <label asp-for="Location" class="control-label"></label>
                        <input asp-for="Location" class="form-control" />
                        <span asp-validation-for="Location" class="text-danger"></span>
                    </div>
                </div>
            </div>
            <div class="form-group mb-3">
                <label asp-for="PickupAddress" class="control-label"></label>
                <textarea asp-for="PickupAddress" class="form-control" rows="2" id="pickupAddress"></textarea>
                <span asp-validation-for="PickupAddress" class="text-danger"></span>
                <button type="button" id="geocodeBtn" class="btn btn-outline-primary btn-sm mt-2">Get Location on Map</button>
            </div>
            
            <div class="form-group mb-3">
                <div id="donationMap" style="height: 300px; width: 100%; border: 1px solid #ccc;"></div>
                <input type="hidden" id="latitude" name="Latitude" />
                <input type="hidden" id="longitude" name="Longitude" />
            </div>
            
            <div class="form-group mb-3">
                <h5>AI-Powered NGO Recommendations</h5>
                <button type="button" id="getRecommendations" class="btn btn-primary">Get Recommended NGOs</button>
                <div id="ngoRecommendations" class="mt-3" style="display: none;">
                    <h6>Recommended NGOs (Ranked by AI)</h6>
                    <div id="recommendationsList"></div>
                </div>
            </div>
            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="control-label"></label>
                <input asp-for="ImageUrl" class="form-control" type="url" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        let donationMap;
        let marker;
        let selectedLocation = null;

        function initDonationMap() {
            donationMap = new google.maps.Map(document.getElementById("donationMap"), {
                center: { lat: 40.7128, lng: -74.0060 },
                zoom: 12
            });

            // Add click listener to map
            donationMap.addListener("click", function(event) {
                if (marker) {
                    marker.setMap(null);
                }
                
                marker = new google.maps.Marker({
                    position: event.latLng,
                    map: donationMap,
                    title: "Donation Location"
                });

                selectedLocation = {
                    lat: event.latLng.lat(),
                    lng: event.latLng.lng()
                };

                document.getElementById("latitude").value = selectedLocation.lat;
                document.getElementById("longitude").value = selectedLocation.lng;

                // Reverse geocode to get address
                reverseGeocode(event.latLng);
            });

            // Try to get user's current location
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(
                    function(position) {
                        const userLocation = {
                            lat: position.coords.latitude,
                            lng: position.coords.longitude
                        };
                        donationMap.setCenter(userLocation);
                        donationMap.setZoom(15);
                    },
                    function() {
                        console.log("Geolocation failed");
                    }
                );
            }
        }

        document.getElementById("geocodeBtn").addEventListener("click", function() {
            const address = document.getElementById("pickupAddress").value;
            if (address) {
                geocodeAddress(address);
            } else {
                alert("Please enter a pickup address first");
            }
        });

        function geocodeAddress(address) {
            fetch('/Map/GeocodeAddress', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ address: address })
            })
            .then(response => response.json())
            .then(data => {
                if (data.latitude && data.longitude) {
                    const location = {
                        lat: data.latitude,
                        lng: data.longitude
                    };
                    
                    donationMap.setCenter(location);
                    donationMap.setZoom(15);
                    
                    if (marker) {
                        marker.setMap(null);
                    }
                    
                    marker = new google.maps.Marker({
                        position: location,
                        map: donationMap,
                        title: "Donation Location"
                    });

                    selectedLocation = location;
                    document.getElementById("latitude").value = location.lat;
                    document.getElementById("longitude").value = location.lng;
                } else {
                    alert("Address not found");
                }
            })
            .catch(error => {
                console.error('Error:', error);
                alert("Error geocoding address");
            });
        }

        function reverseGeocode(latLng) {
            const geocoder = new google.maps.Geocoder();
            geocoder.geocode({ location: latLng }, function(results, status) {
                if (status === 'OK' && results[0]) {
                    document.getElementById("pickupAddress").value = results[0].formatted_address;
                }
            });
        }

        // ML Recommendations functionality
        document.getElementById("getRecommendations").addEventListener("click", function() {
            getNGORecommendations();
        });

        function getNGORecommendations() {
            const foodType = document.getElementById("FoodType").value;
            const quantity = document.getElementById("Quantity").value;
            const unit = document.getElementById("Unit").value;
            const expiryDate = document.getElementById("ExpiryDate").value;
            const latitude = document.getElementById("latitude").value;
            const longitude = document.getElementById("longitude").value;
            const pickupAddress = document.getElementById("pickupAddress").value;

            if (!foodType || !quantity || !expiryDate) {
                alert("Please fill in the required donation details first");
                return;
            }

            if (!latitude || !longitude) {
                alert("Please set the pickup location on the map first");
                return;
            }

            const requestData = {
                foodType: foodType,
                quantity: parseInt(quantity),
                unit: unit || "kg",
                expiryDate: expiryDate,
                donorLatitude: parseFloat(latitude),
                donorLongitude: parseFloat(longitude),
                donorLocation: pickupAddress,
                createdAt: new Date().toISOString()
            };

            fetch('/api/ML/GetRecommendedNGOs', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(requestData)
            })
            .then(response => response.json())
            .then(data => {
                displayRecommendations(data);
            })
            .catch(error => {
                console.error('Error:', error);
                alert("Error getting recommendations");
            });
        }

        function displayRecommendations(recommendations) {
            const recommendationsDiv = document.getElementById("ngoRecommendations");
            const recommendationsList = document.getElementById("recommendationsList");
            
            recommendationsDiv.style.display = "block";
            recommendationsList.innerHTML = "";

            if (recommendations.length === 0) {
                recommendationsList.innerHTML = "<p>No NGOs found within the specified criteria.</p>";
                return;
            }

            recommendations.forEach((ngo, index) => {
                const ngoCard = document.createElement("div");
                ngoCard.className = "card mb-2";
                ngoCard.innerHTML = `
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title">${index + 1}. ${ngo.ngoName}</h6>
                                <p class="card-text small mb-1">${ngo.description}</p>
                                <p class="card-text small mb-1"><strong>Contact:</strong> ${ngo.contact}</p>
                                <p class="card-text small mb-1"><strong>Location:</strong> ${ngo.location}</p>
                            </div>
                            <div class="text-end">
                                <span class="badge bg-${getDemandBadgeColor(ngo.predictedDemandLevel)}">${ngo.predictedDemandLevel} Demand</span>
                                <div class="small text-muted mt-1">
                                    <div>Distance: ${ngo.distanceKm.toFixed(1)} km</div>
                                    <div>Capacity: ${ngo.capacity}</div>
                                    <div>Match Score: ${(ngo.matchScore * 100).toFixed(0)}%</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-primary" onclick="contactNGO(${ngo.ngoId}, '${ngo.ngoName}')">
                                Contact This NGO
                            </button>
                        </div>
                    </div>
                `;
                recommendationsList.appendChild(ngoCard);
            });
        }

        function getDemandBadgeColor(demandLevel) {
            switch (demandLevel) {
                case "High": return "danger";
                case "Medium": return "warning";
                case "Low": return "success";
                default: return "secondary";
            }
        }

        function contactNGO(ngoId, ngoName) {
            alert(`Contacting ${ngoName} (ID: ${ngoId}). This would open a contact form or initiate communication.`);
        }
    </script>
    
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapsApiKey&callback=initDonationMap"></script>
}
