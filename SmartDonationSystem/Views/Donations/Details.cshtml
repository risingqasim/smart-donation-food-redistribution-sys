@model SmartDonationSystem.Models.Donation

@{
    ViewData["Title"] = "Donation Details";
}

<h1>Donation Details</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.Title" style="height: 300px; object-fit: cover;">
            }
            <div class="card-body">
                <h2 class="card-title">@Model.Title</h2>
                <p class="card-text">@Model.Description</p>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Food Type:</strong> @Model.FoodType
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong> 
                        <span class="badge bg-@(Model.Status == "Available" ? "success" : Model.Status == "Reserved" ? "warning" : Model.Status == "Collected" ? "success" : "secondary")">@Model.Status</span>
                    </div>
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Quantity:</strong> @Model.Quantity @Model.Unit
                    </div>
                    <div class="col-md-6">
                        <strong>Expiry Date:</strong> @Model.ExpiryDate.ToString("MMM dd, yyyy")
                    </div>
                </div>
                
                <div class="mb-3">
                    <strong>Pickup Address:</strong> @Model.PickupAddress
                </div>
                
                @if (!string.IsNullOrEmpty(Model.Location))
                {
                    <div class="mb-3">
                        <strong>Location:</strong> @Model.Location
                    </div>
                }
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Donor:</strong> @Model.Donor?.FirstName @Model.Donor?.LastName
                    </div>
                    @if (Model.NGO != null)
                    {
                        <div class="col-md-6">
                            <strong>Reserved by:</strong> @Model.NGO.Name
                        </div>
                    }
                </div>
                
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Created:</strong> @Model.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                    </div>
                    @if (Model.UpdatedAt.HasValue)
                    {
                        <div class="col-md-6">
                            <strong>Last Updated:</strong> @Model.UpdatedAt.Value.ToString("MMM dd, yyyy HH:mm")
                        </div>
                    }
                </div>
            </div>
        </div>
        
        <div class="mt-3">
            @if ((User.IsInRole("Donor") && Model.DonorId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) || User.IsInRole("Admin"))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Delete</a>
            }
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </div>
    </div>
</div>
