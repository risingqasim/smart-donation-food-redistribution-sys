# Smart Donation System Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration
SQL_SERVER=localhost
SQL_DATABASE=SmartDonationSystemDb
SQL_USER=sa
SQL_PASSWORD=YourStrong@Passw0rd

# JWT Configuration
JWT_SECRET_KEY=YourSuperSecretKeyThatIsAtLeast32CharactersLong!
JWT_ISSUER=SmartDonationSystem
JWT_AUDIENCE=SmartDonationSystemUsers
JWT_EXPIRY_MINUTES=60

# Google Maps API
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@smartdonationsystem.com
FROM_NAME=Smart Donation System

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80;https://+:443

# Security Settings
REQUIRE_HTTPS=true
HSTS_MAX_AGE=31536000

# File Storage
UPLOAD_PATH=wwwroot/uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.pdf

# CORS Settings
ALLOWED_ORIGINS=https://smartdonationsystem.azurewebsites.net,https://www.smartdonationsystem.com

# Rate Limiting
REQUESTS_PER_MINUTE=100
BURST_LIMIT=200

# Application Insights
APPINSIGHTS_INSTRUMENTATIONKEY=your-application-insights-key

# Redis Configuration (for caching)
REDIS_CONNECTION_STRING=localhost:6379

# Logging
LOG_LEVEL=Information
LOG_LEVEL_MICROSOFT_ASPNETCORE=Warning
LOG_LEVEL_MICROSOFT_ENTITYFRAMEWORKCORE=Warning
